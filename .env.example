# ==============================================================================
# BatchGuard Environment Configuration (.env.example)
# NEVER commit sensitive production credentials or actual .env files to Git.
# ==============================================================================

# AWS General Settings
AWS_REGION=us-east-1
ENVIRONMENT=development

# DynamoDB Configuration
DYNAMODB_TABLE_NAME=BatchGuard-Main-dev

# Amazon S3 Configuration
S3_EVIDENCE_BUCKET_NAME=batchguard-evidence-vault-dev-us-east-1

# Amazon SNS Topics
SNS_RECALL_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:batchguard-recall-notifications-dev

# AWS Step Functions State Machine
STEP_FUNCTIONS_RECALL_ARN=arn:aws:states:us-east-1:123456789012:stateMachine:BatchGuardRecallOrchestrator-dev

# Frontend Configuration (Vite)
VITE_API_BASE_URL=https://api-dev.batchguard.internal/v1
VITE_AWS_REGION=us-east-1
VITE_APP_ENV=development

